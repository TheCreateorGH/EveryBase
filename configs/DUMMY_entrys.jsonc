{
    "$schema": "./schema/entrys.json",

    "name": {
        "field_type": "str_trimmed",
        "required": true, // Whether this field is required to fill
        "unique": true, // Whether the value of this field must be unique across all entries
        "default": null
    },
    "email": {
        "field_type": "email",
        "required": true,
        "unique": true,
        "default": null
    },
    "age": {
        "field_type": "uint8",
        "required": true,
        "unique": false,
        "default": null
    },
    "active": {
        "field_type": "bool",
        "required": false,
        "unique": false,
        "default": true
    }
}